# Camera
CONFIG_ISPV3=m

# Fingerprint
# CONFIG_FINGERPRINT_FPC_1540 is not set
CONFIG_FINGERPRINT_FPC_1552=m

# Power
CONFIG_BQ_FG_UPDATE=y
CONFIG_MI_CHARGER_M81=y
CONFIG_MI_THERMAL_MULTI_CHARGE=y

# Keyboard
CONFIG_KEYBOARD_NANO_8030=m

# Touchscreen
# The LCD implementation owns the xiaomi-touch ABI for liuqin.
# CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE is not set
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE_LCD=m
CONFIG_TOUCHSCREEN_NT36532_SPI=m
